aws_access_key          = "<your-access-key>"           # AWS Access Key ID, found in AWS Console under Security Credentials
aws_secret_key          = "<your-secret-key>"           # AWS Secret Access Key, found in AWS Console under Security Credentials
region                  = "<your-region>"               # AWS region for deployment (e.g., us-east-1)
environment_name        = "<your-environment-name>"     # Environment name, used in resource naming (e.g., cabbage)
location                = "<your-location>"             # Location identifier, used in resource naming (e.g., uswest2)
my_public_ip            = "<your-public-ip>"            # Your public IP for RDP access (e.g., 203.0.113.5/32)
key_name                = "<your-key-name>"             # EC2 Key Pair name, found in AWS Console under EC2 > Key Pairs (e.g., cabbage-key)
shared_secret_oci       = "<your-shared-secret>"        # Shared secret for the IPSEC connection to OCI
oci_vpn_ip_tunnel1_temp = "<oci-vpn-ip-tunnel1-temp>"   # Dummy OCI VPN IP (e.g., 1.1.1.1)
oci_vpn_ip_tunnel1      = "<oci-vpn-ip-tunnel1>"        # OCI VPN IP to be updated after OCI apply (e.g., 150.136.200.108)